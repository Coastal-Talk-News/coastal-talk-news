# Backend configuration — the single source for everything server-side.
# Copy to `.env` in this folder (gitignored) and fill in.
#
# The Prisma CLI reads this same file (see packages/db/prisma.config.ts), so
# migrations, the seed, Studio and the running API all share one connection
# string and cannot drift onto different databases.
#
# Deployed environments never read this file — set these in Render's dashboard
# and they arrive as real environment variables.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SUPABASE — which connection string you copy matters. In the dashboard:
#   Project → Connect → "Session pooler"   ← use this one
#
# Why not the other two:
#   - "Direct connection" (db.<ref>.supabase.co) is IPv6-only. Most home ISPs
#     and CI runners are IPv4, so it fails to connect at all.
#   - "Transaction pooler" (port 6543) holds no session state. Prisma Migrate
#     needs advisory locks and prepared statements, so migrations break on it.
#   - "Session pooler" (port 5432, pooler.supabase.com) is IPv4 and keeps
#     session state, so it serves both migrations and the running API.
#
# sslmode=require is mandatory — Supabase refuses unencrypted connections.
DATABASE_URL='postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require'

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV='development'
PORT=8000

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Signs the session cookie. Minimum 32 characters — generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Sessions idle out after this long without a request.
SESSION_IDLE_MINUTES=480
# Oldest sessions drop past this, so memory cannot grow without bound.
SESSION_MAX_PER_USER=10

# Leave unset in development. In production, scope the cookie to the API host:
# COOKIE_DOMAIN=coastal-talk-news-api.onrender.com

# Exact origins, comma separated. No wildcards: the session cookie is sent with
# credentials, which browsers refuse against a wildcard origin.
# Defaults below are the web dev server and the CMS dev server.
CORS_ORIGINS='http://localhost:3000,http://localhost:5173'

# ---------------------------------------------------------------------------
# Cloudflare R2 (media storage)
# ---------------------------------------------------------------------------
# Placeholders on purpose. The API validates these at boot, so they must be
# non-empty; nothing reads them until the Media Library is built. Replace with
R2_ACCOUNT_ID='not-configured'
R2_ACCESS_KEY_ID='not-configured'
R2_SECRET_ACCESS_KEY='not-configured'
R2_BUCKET='coastal-talk-news-media'
R2_PUBLIC_BASE_URL='https://media.example.com'

# ---------------------------------------------------------------------------
# Seed — used once by `pnpm db:seed` to create the first CMS admin.
# There is no signup flow by design, so this is the only way into the CMS.
# SEED_ADMIN_PASSWORD has no default on purpose: a fallback would ship a known
# credential to every environment that forgot to set it.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL='admin@coastaltalknews.com'
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME='Administrator'
SEED_SITE_NAME='Coastal Talk News'
