# Copy to `.env` in this folder and fill in. The Prisma CLI reads this same
# file, so migrations, the seed and the API share one connection string.
# Deployed environments set these in the host dashboard instead.

# Supabase: use the "Session pooler" string (port 5432). The direct connection
# is IPv6-only, and the transaction pooler (6543) breaks Prisma Migrate.
DATABASE_URL='postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require'

NODE_ENV='development'
PORT=8000

# Minimum 32 characters:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=480
SESSION_MAX_PER_USER=10

# Production only, scoped to the API host:
# COOKIE_DOMAIN=coastal-talk-news-api.onrender.com

# Exact origins, comma separated — a credentialed cookie is refused against a wildcard.
CORS_ORIGINS='http://localhost:3000,http://localhost:5173'

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=coastal-talk-news

# Used once by `pnpm db:seed`. SEED_ADMIN_PASSWORD has no default on purpose —
# a fallback would ship a known credential.
SEED_ADMIN_EMAIL='admin@coastaltalknews.com'
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME='Administrator'
SEED_SITE_NAME='Coastal Talk News'
