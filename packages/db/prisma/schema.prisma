// Two rules here are product decisions, not implementation details, and must
// not be "fixed" without changing docs/DATA-MODEL.md:
//   1. BreakingNews and Advertisement store no is_active column — active state
//      is derived from start_at/end_at at query time (CLAUDE.md §13).
//   2. Every media_id FK is onDelete: Restrict. A MediaAsset is removed only
//      once nothing references it, via the API's central release check.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// Prisma 7 no longer accepts `url` here. Migrate reads it from prisma.config.ts;
// the client gets it via a driver adapter (src/index.ts).
datasource db {
  provider = "postgresql"
}

/// Also used for SiteSettings.defaultUiLanguage, a fixed config value — V1 has
/// no reader-facing language switcher.
enum Language {
  ENGLISH
  KANNADA
}

/// No SCHEDULED member: publishing is immediate in V1.
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticlePriority {
  LEAD_STORY
  FEATURED
  NORMAL
}

/// MASTHEAD is the single premium slot beside the site name; TOP is the band
/// below the header; SIDEBAR is the rail. Each is sold separately. FOOTER
/// exists in the database (another developer's in-progress work) but has no
/// application code wired to it yet - not offered as a choice anywhere.
enum AdPlacement {
  MASTHEAD
  TOP
  SIDEBAR
  FOOTER
}

/// How a Masthead or Top ad handles whatever its own crop doesn't cover -
/// a choice for those two zones only (see Advertisement.fitMode); Sidebar
/// never reads this, since it sets width alone and lets height follow the
/// artwork, so there's never a gap to resolve. It is independent of
/// zoom/offsetX/offsetY: the admin can zoom either to any amount, from the
/// whole image up past a full cover, in any of these three modes.
/// FIT_SHRINK removes whatever gap is left at the current zoom by sizing
/// the slot down to match what's actually drawn, so no gap is ever shown;
/// FIT_SPACE keeps the slot at its full size and leaves that gap plainly
/// empty; FIT_BACKGROUND keeps the slot at its full size and fills the gap
/// with a softly blurred, enlarged copy of the same creative.
///
/// FILL is an unused leftover from an earlier version of this same enum,
/// where crop was gated behind it; nothing writes it any more (see FOOTER
/// above for the same situation). Postgres has no DROP VALUE for enums, so
/// it stays in the type rather than forcing a type-swap migration on a
/// shared database for a value nothing ever reads.
enum AdFitMode {
  FILL
  FIT_SHRINK
  FIT_SPACE
  FIT_BACKGROUND
}

model MediaAsset {
  id         String   @id @default(uuid(7))
  filename   String
  storageKey String   @unique @map("storage_key")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  /// Captured by Sharp on upload so frontends can reserve layout space and ad
  /// zones can lay out by aspect ratio without measuring images.
  width      Int
  height     Int
  createdAt  DateTime @default(now()) @map("created_at")

  featuredForArticles Article[]       @relation("ArticleFeaturedImage")
  ogImageForArticles  Article[]       @relation("ArticleOgImage")
  categories          Category[]
  advertisements      Advertisement[] @relation("AdvertisementImage")
  detailForAds        Advertisement[] @relation("AdvertisementDetailImage")
  articleUses         ArticleMedia[]
  pageUses            SitePageMedia[]
  logoForSettings     SiteSettings[]  @relation("SettingsLogo")
  faviconForSettings  SiteSettings[]  @relation("SettingsFavicon")
  ogImageForSettings  SiteSettings[]  @relation("SettingsDefaultOgImage")

  @@map("media_assets")
}

/// One row per counted read (see `Article.viewCount`), kept only for its
/// timestamp — the analytics page's Today/Week/Month/Year figures are a
/// count of these rows in a date range. No reader information: this is the
/// same anonymous event the running total already represents, just dated.
/// A slug a published article used to have, so links shared before the
/// editor changed it still arrive: the old address redirects to the current
/// one. Always points at the article, never at another old slug, so there are
/// no chains. Goes with the article when it is deleted — a deleted article's
/// links 404 rather than redirecting somewhere else.
model ArticleSlugRedirect {
  slug      String   @id
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_slug_redirects")
}

model ArticleView {
  id        String   @id @default(uuid(7))
  articleId String   @map("article_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([viewedAt])
  @@index([articleId])
  @@map("article_views")
}

model Category {
  id              String   @id @default(uuid(7))
  name            String   @unique
  /// Shown instead of `name` when a reader has the site set to Kannada. The
  /// API and CMS require it on every save; the column stays nullable so
  /// categories that predate it keep working, falling back to `name`.
  nameKannada     String?  @map("name_kannada")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @map("display_order")
  mediaId         String?  @map("media_id")
  /// Nullable — null means top-level. Grouping can nest to any depth, but a
  /// category can only hold articles directly (via Article.categoryId) or
  /// have children, never both — enforced in the service layer, not by the
  /// DB. Cycle prevention (a category can't become its own ancestor) is also
  /// service-layer only.
  parentId        String?  @map("parent_id")
  /// The section's address: /category/<slug>. Made from the name when the
  /// category is created and never changed by renaming it, so links stay
  /// valid; an editor can change it by hand. Nullable only so rows written
  /// before slugs existed stay valid; the public site falls back to the id.
  slug            String?  @unique
  /// Search-result title and description for the section page; the public
  /// site falls back to "<name> News | <site>" and a generic line.
  seoTitle        String?  @map("seo_title")
  metaDescription String?  @map("meta_description")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  media    MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  parent   Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]  @relation("CategoryHierarchy")
  articles Article[]

  @@index([isActive, displayOrder])
  @@index([parentId, displayOrder])
  @@map("categories")
}

model Article {
  id         String  @id @default(uuid(7))
  /// Nullable in the database, but the API requires a category on create.
  categoryId String? @map("category_id")
  mediaId    String? @map("media_id")
  ogImageId  String? @map("og_image_id")

  language            Language
  headline            String
  summary             String
  /// Tiptap document JSON, not HTML. The public site renders it
  /// programmatically, so stored content cannot inject markup.
  content             Json
  /// How the featured image is framed on the article page: only what differs
  /// from the default (full width, centred, uncropped), so most rows hold `{}`.
  featuredImageLayout Json     @default("{}") @map("featured_image_layout")
  /// Flattened plain text of content, maintained by the API for search.
  contentText         String   @map("content_text")
  youtubeUrl          String?  @map("youtube_url")
  tags                String[] @default([])

  priority        ArticlePriority @default(NORMAL)
  status          ArticleStatus   @default(DRAFT)
  /// Null until first published.
  publicationDate DateTime?       @map("publication_date")
  /// Optional scheduled end: from this moment the article is off the public
  /// site, though it stays Published in the CMS. Like breaking news, the time
  /// is the source of truth, so nothing has to flip a stored status.
  endAt           DateTime?       @map("end_at")

  seoTitle        String? @map("seo_title")
  metaDescription String? @map("meta_description")
  /// The public address: /article/<slug>, in the headline's own language (a
  /// Kannada headline gives a Kannada slug). Made from the headline when none
  /// is given, and never changed by a headline edit. Nullable only for rows
  /// from before slugs; the id stays the primary key and every relation's
  /// target.
  slug            String? @unique

  /// Reads counted by the public site: one per visit, once the reader has
  /// stayed for half the article's estimated read time. A running total;
  /// `views` below is the same reads, timestamped, so they can be counted
  /// by period (today, this week...) without re-scanning every article.
  viewCount Int @default(0) @map("view_count")

  views ArticleView[]

  slugRedirects ArticleSlugRedirect[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Generated column maintained by Postgres; GIN-indexed for article search.
  searchVector Unsupported("tsvector")? @map("search_vector")

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media    MediaAsset?    @relation("ArticleFeaturedImage", fields: [mediaId], references: [id], onDelete: Restrict)
  ogImage  MediaAsset?    @relation("ArticleOgImage", fields: [ogImageId], references: [id], onDelete: Restrict)
  images   ArticleMedia[]

  @@index([status, publicationDate(sort: Desc)])
  @@index([categoryId, status, publicationDate(sort: Desc)])
  @@index([status, priority, publicationDate(sort: Desc)])
  @@index([language])
  @@map("articles")
}

/// The images placed inside an article's body, kept in step with `content` by
/// the API so a picture in use cannot be deleted from the media library.
model ArticleMedia {
  articleId String @map("article_id")
  mediaId   String @map("media_id")

  article Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([articleId, mediaId])
  @@index([mediaId])
  @@map("article_media")
}

enum SitePage {
  ABOUT
  ADVERTISE
  PRIVACY
  TERMS

  @@map("site_page")
}

/// The same for the rich-text pages held in site settings. A page is named,
/// not referenced, because settings is a single row.
model SitePageMedia {
  page    SitePage
  mediaId String   @map("media_id")

  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([page, mediaId])
  @@index([mediaId])
  @@map("site_page_media")
}

/// articleUrl is a plain URL, deliberately not an FK — breaking news can point
/// outside the article system.
///
/// endAt is nullable by product decision: an admin can leave it unset to run
/// the item indefinitely from startAt, and take it down by deleting the row
/// rather than by setting an end time. Still no is_active column — active
/// state is startAt <= now <= (endAt ?? never), computed at query time
/// (CLAUDE.md §13).
model BreakingNews {
  id                String    @id @default(uuid(7))
  headline          String
  /// Shown instead of `headline` when a reader has the site set to Kannada;
  /// null falls back to `headline`.
  headlineKannada   String?   @map("headline_kannada")
  articleUrl        String    @map("article_url")
  /// Used for Kannada readers; null falls back to `articleUrl`.
  articleUrlKannada String?   @map("article_url_kannada")
  startAt           DateTime  @map("start_at")
  endAt             DateTime? @map("end_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([startAt, endAt])
  @@map("breaking_news")
}

/// placement chooses the reader-site ad zone: MASTHEAD (a 520×96 banner,
/// capped at 1 active ad), TOP (a 408×88 band, capped at 4 active ads), or
/// SIDEBAR (a 250×300 rail, uncapped, and the column default) - every cap is
/// enforced in the service layer, not a DB constraint. displayOrder still
/// orders ads within whichever zone they land in, not which zone they land in.
model Advertisement {
  id              String      @id @default(uuid(7))
  mediaId         String      @map("media_id")
  /// Larger creative shown on the ad's own page, where there is room for it.
  detailMediaId   String?     @map("detail_media_id")
  advertiserName  String      @map("advertiser_name")
  /// Optional: an advertiser may have no website of their own to link to.
  destinationUrl  String?     @map("destination_url")
  /// Tiptap document, rendered only on the ad's own page.
  description     Json?
  /// Plain-text mirror of description, so listings and meta tags never have to
  /// load and walk the document.
  descriptionText String?     @map("description_text")
  /// Position within its own placement zone, ascending - set only by the CMS
  /// drag-to-reorder action (PATCH .../order), never by hand. Top and Sidebar
  /// are ordered independently: this column is compared only against other
  /// rows sharing the same placement, never across zones.
  displayOrder    Int         @default(0) @map("display_order")
  placement       AdPlacement @default(SIDEBAR)
  /// Masthead and Top ads only (see the enum) - defaults to the gap-free
  /// choice so an untouched ad never shows an uneven space, but every
  /// Masthead or Top ad's admin can change it per ad.
  fitMode         AdFitMode   @default(FIT_SHRINK) @map("fit_mode")
  /// How the creative is framed inside the slot the advertiser bought, set in
  /// the CMS by dragging and zooming the image the way a profile-picture
  /// cropper works. 100 means the whole image sits inside the slot; above
  /// that it is enlarged and the slot crops it. Only the zones that fix both
  /// dimensions (Masthead, Top) frame anything - the Right Side rail sets
  /// width alone and lets height follow the artwork. Meaningful for every
  /// Masthead and Top ad, independent of fitMode - fitMode only decides
  /// what happens to whatever this doesn't cover.
  zoom            Int         @default(100)
  /// Pan, as a percentage of the slot's own width and height, applied before
  /// the zoom. 0/0 is centred.
  offsetX         Int         @default(0) @map("offset_x")
  offsetY         Int         @default(0) @map("offset_y")
  startAt         DateTime    @map("start_at")
  endAt           DateTime    @map("end_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  media       MediaAsset  @relation("AdvertisementImage", fields: [mediaId], references: [id], onDelete: Restrict)
  detailMedia MediaAsset? @relation("AdvertisementDetailImage", fields: [detailMediaId], references: [id], onDelete: Restrict)

  @@index([startAt, endAt])
  // Covers a plain placement lookup too (leftmost prefix), so the separate
  // single-column index this replaced is redundant.
  @@index([placement, displayOrder])
  @@map("advertisements")
}

/// Single-tier admin access — no role column by design.
model CmsUser {
  id           String @id @default(uuid(7))
  name         String
  email        String @unique
  /// bcrypt hash. Never returned by any endpoint, never logged.
  passwordHash String @map("password_hash")

  /// The authenticator secret, sealed with AES-256-GCM (see the API's
  /// SecretBox) so a copy of this table alone can't mint codes. Written only
  /// once the user has proved their authenticator works. Never returned.
  totpSecret    String?   @map("totp_secret")
  /// Null means two-factor isn't set up yet: the next sign-in enrols instead
  /// of asking for a code. Set at the moment the first code is confirmed.
  totpEnabledAt DateTime? @map("totp_enabled_at")
  /// Highest 30-second time step already accepted, so a code that was used
  /// (or sniffed) can't be replayed inside its validity window.
  totpLastStep  Int?      @map("totp_last_step")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recoveryCodes CmsRecoveryCode[]
  sessions      CmsSession[]

  @@map("cms_users")
}

/// A signed-in device. Only the SHA-256 hash of the session token is stored
/// (as the primary key), never the token itself, so a copy of this table
/// can't be replayed as a cookie. A session past `expiresAt` is deleted
/// outright by the API's periodic sweep rather than flagged inactive - there
/// is no reason to keep it around.
model CmsSession {
  id         String   @id @map("token_hash")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  /// Bumped on every authenticated request; the idle timeout is measured
  /// from this, separately from the absolute `expiresAt`.
  lastSeenAt DateTime @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  user CmsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Serves both the per-user session list (newest first) and the per-user
  // cap eviction, which also orders by lastSeenAt.
  @@index([userId, lastSeenAt])
  // Serves the periodic sweep's DELETE WHERE expires_at <= now().
  @@index([expiresAt])
  @@map("cms_sessions")
}

/// One-time codes for a lost authenticator. Only a keyed hash is stored: the
/// code itself is shown once, at creation, and never again.
model CmsRecoveryCode {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user CmsUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cms_recovery_codes")
}

/// Effectively a singleton — exactly one row, created by the seed.
model SiteSettings {
  id       String  @id @default(uuid(7))
  siteName String  @map("site_name")
  tagline  String?

  logoMediaId    String? @map("logo_media_id")
  faviconMediaId String? @map("favicon_media_id")

  contactEmail   String? @map("contact_email")
  contactPhone   String? @map("contact_phone")
  contactAddress String? @map("contact_address")

  /// Each standalone page owns its heading, intro and body. All optional:
  /// an empty field falls back to a site-wide value, so the pages render
  /// before anyone has filled them in. Contact details are not duplicated
  /// here — every page reads the single set above.
  aboutTitle          String? @map("about_title")
  aboutIntro          String? @map("about_intro")
  /// Tiptap document JSON, same shape as Article.content — rendered by the
  /// reader site's own node renderer, never as HTML.
  aboutContent        Json?   @map("about_content")
  /// Kannada body for the About page. Null falls back to `aboutContent` (the
  /// English body) — see the reader-site service layer, not the DB.
  aboutContentKannada Json?   @map("about_content_kannada")

  contactTitle String? @map("contact_title")
  contactIntro String? @map("contact_intro")
  contactHours String? @map("contact_hours")

  advertiseTitle   String? @map("advertise_title")
  advertiseIntro   String? @map("advertise_intro")
  advertiseContent Json?   @map("advertise_content")

  /// The Privacy Policy page's body, a Tiptap document like the page bodies
  /// above. Only a body: the page's heading is fixed, not editable.
  privacyContent Json? @map("privacy_content")
  termsContent   Json? @map("terms_content")

  facebookUrl        String? @map("facebook_url")
  instagramUrl       String? @map("instagram_url")
  youtubeUrl         String? @map("youtube_url")
  xUrl               String? @map("x_url")
  /// Separate links because the newsroom runs distinct WhatsApp channels per
  /// content language, not one shared channel — matches Article.language.
  /// The reader site picks whichever matches its current UI-language toggle.
  whatsappEnglishUrl String? @map("whatsapp_english_url")
  whatsappKannadaUrl String? @map("whatsapp_kannada_url")

  defaultUiLanguage Language @default(KANNADA) @map("default_ui_language")

  /// Backstop cache window for a reader-site article page, in minutes - a
  /// publish/edit invalidates it immediately regardless.
  articleCacheMinutes Int @default(60) @map("article_cache_minutes")

  defaultSeoTitle        String? @map("default_seo_title")
  defaultMetaDescription String? @map("default_meta_description")
  defaultOgImageId       String? @map("default_og_image_id")
  /// The content of Google Search Console's verification meta tag. Emitted on
  /// the reader site only when set.
  googleSiteVerification String? @map("google_site_verification")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logo           MediaAsset? @relation("SettingsLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  favicon        MediaAsset? @relation("SettingsFavicon", fields: [faviconMediaId], references: [id], onDelete: Restrict)
  defaultOgImage MediaAsset? @relation("SettingsDefaultOgImage", fields: [defaultOgImageId], references: [id], onDelete: Restrict)

  @@map("site_settings")
}
