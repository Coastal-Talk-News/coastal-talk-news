# Copy to `.env` in this folder and fill in. The Prisma CLI reads this same
# file, so migrations, the seed and the API share one connection string.
# Deployed environments set these in the host dashboard instead.

# Supabase: use the "Session pooler" string (port 5432). The direct connection
# is IPv6-only, and the transaction pooler (6543) breaks Prisma Migrate.
DATABASE_URL='postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require'

NODE_ENV='development'
PORT=8000

# Minimum 32 characters:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=480
SESSION_MAX_PER_USER=10

# Seals every user's authenticator secret in the database. 32 random bytes:
#   node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# Everyone using the same database must use the same value, and changing it
# later means every user has to set up two-factor again.
TOTP_ENCRYPTION_KEY=

# Production only, scoped to the API host:
# COOKIE_DOMAIN=coastal-talk-news-api.onrender.com

# Exact origins, comma separated — a credentialed cookie is refused against a wildcard.
CORS_ORIGINS='http://localhost:3000,http://localhost:5173'

# Which backend image uploads go to - 'cloudinary' or 's3'. Only the
# matching block below is required; switching is a config change only.
STORAGE_PROVIDER='cloudinary'

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER='coastal-talk-news'

# S3-compatible (AWS S3, Cloudflare R2, or anything else speaking the same
# API). Required only when STORAGE_PROVIDER=s3.
#   S3_ENDPOINT      - leave unset for real AWS S3; for R2 use
#                      https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION        - a real AWS region for S3 (e.g. ap-south-1); 'auto' for R2
#   S3_PUBLIC_URL    - the base URL objects are served from (a public bucket
#                      URL or a custom domain in front of one) - required,
#                      since bucket endpoints aren't public read by default
#   S3_FORCE_PATH_STYLE - set true only if your provider needs
#                         https://host/bucket/key instead of
#                         https://bucket.host/key
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false
# S3_FOLDER=coastal-talk-news

# Hard ceiling on total stored image size, decimal MB, regardless of
# provider. New uploads are refused once reached.
MEDIA_STORAGE_CAP_MB=5000

# Lets this server drop a reader-site article page's cache the moment it's
# published, edited or deleted, instead of waiting out its cache window.
# Both optional - caching still works without them, just relying on its own
# TTL (Settings → Advanced in the CMS) rather than being invalidated
# immediately. WEB_REVALIDATE_SECRET must match the web app's
# REVALIDATE_SECRET exactly.
# WEB_BASE_URL='http://localhost:3000'
# WEB_REVALIDATE_SECRET=

# Lets two-factor sign-in offer a one-time code by email, alongside the
# authenticator app. Both optional - leaving them unset keeps two-factor
# authenticator-only exactly as before. Must be set together.
# RESEND_API_KEY=
# EMAIL_OTP_FROM='Coastal Talk News <security@coastaltalknews.com>'

# Used once by `pnpm db:seed`. SEED_ADMIN_PASSWORD has no default on purpose —
# a fallback would ship a known credential.
SEED_ADMIN_EMAIL='admin@coastaltalknews.com'
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME='Administrator'
SEED_SITE_NAME='Coastal Talk News'
