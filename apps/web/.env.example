# Base URL of the news API. Server-side only; never exposed to the browser.
API_BASE_URL='http://localhost:8000'

# The one address search engines should know the site by. Every canonical
# tag, Open Graph URL, structured-data URL, sitemap entry and share link is
# built on it. Production: https://www.coastaltalknews.com — set it for every
# Vercel environment, so preview deployments also point at the real site, and
# make that same host Vercel's primary domain (the bare domain redirecting to it): a
# canonical URL that itself redirects sends search engines mixed signals.
# Leave unset locally to use whatever host you're browsing on.
# PUBLIC_SITE_URL='https://www.coastaltalknews.com'
